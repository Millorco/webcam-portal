{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viewlapse.com/schemas/contratto/evento-v1.schema.json",
  "title": "Lotto di eventi (event/1)",
  "description": "Corpo di POST /api/v1/event: fatti puntuali del router (riavvii, errori della fotocamera, cambi di versione...). I tipi sono elencati in api-portal-v1.md.",
  "type": "object",
  "required": ["schema", "mac", "events"],
  "properties": {
    "schema": { "const": "event/1" },
    "mac": { "type": "string", "pattern": "^([0-9a-f]{2}:){5}[0-9a-f]{2}$" },
    "hostname": { "type": ["string", "null"], "maxLength": 100 },
    "app_version": { "type": ["string", "null"], "maxLength": 30 },
    "sent_at": { "type": "integer", "minimum": 0 },
    "time_synced": { "type": "boolean" },
    "events": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "time", "time_synced", "type", "severity"],
        "properties": {
          "id": {
            "description": "<boot_id>-E<seq>: unico per webcam, per l'idempotenza.",
            "type": "string", "pattern": "^[0-9a-f]{8}-E[0-9]{1,10}$"
          },
          "time": { "type": "integer", "minimum": 0 },
          "time_synced": { "type": "boolean" },
          "time_corrected": { "type": "boolean" },
          "uptime": { "type": ["integer", "null"], "minimum": 0 },
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9_.]{1,39}$" },
          "severity": { "enum": ["debug", "info", "notice", "warning", "error", "critical"] },
          "message": { "type": ["string", "null"], "maxLength": 500 },
          "data": { "type": ["object", "null"], "additionalProperties": true }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
