# webcam-portal in Docker: copia in .env (ignorato da git) e compila.
APP_ENV=prod
# MariaDB del VPS: host.docker.internal se è installato sull'host,
# oppure il nome del container MariaDB sulla rete shared-network
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=webcam2
DB_USER=webcam2
DB_PASS=
PUBLIC_BASE_URL=https://portal.viewlapse.com
PHOTO_MAX_BYTES=26214400
RETENTION_PHOTOS_DAYS=90
RETENTION_MEASUREMENTS_MONTHS=12
# Dolibarr (utente API webcam-portal); vuoto = sincronizzazione spenta
DOLIBARR_URL=
DOLIBARR_API_KEY=
