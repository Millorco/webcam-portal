# webcam-portal in Docker: copia in .env (ignorato da git) e compila.
APP_ENV=prod
# MariaDB del VPS: host.docker.internal se è installato sull'host,
# oppure il nome del container MariaDB sulla rete shared-network
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=webcam2
DB_USER=webcam2
DB_PASS=
PUBLIC_BASE_URL=https://portal.viewlapse.com
PHOTO_MAX_BYTES=26214400
RETENTION_PHOTOS_DAYS=90
RETENTION_MEASUREMENTS_MONTHS=12
# Dolibarr (utente API webcam-portal); vuoto = sincronizzazione spenta
DOLIBARR_URL=
DOLIBARR_API_KEY=
# Link rttys nei ticket se Dolibarr non li manda
RTTYS_URL=https://remote.viewlapse.com
# VictoriaLogs (webcam-logserver), sola lettura; vuoto = regole logs.* solo con gli eventi
VICTORIALOGS_URL=http://victorialogs:9428
VICTORIALOGS_USER=admin
VICTORIALOGS_PASS=
VICTORIALOGS_TIMEOUT=5
# Analisi delle foto: memoria massima di bin/photo-metrics.php
PHOTO_METRICS_MEMORY=512M
# Disponibilità mensile nella pagina pubblica delle webcam pubbliche (0/1)
AVAILABILITY_PUBLIC=0
